<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>opencover</Format>
          <ExcludeByFile>**/Migrations/**,**/FurniSpace.Testing/**,**/Program.cs,**/Constants/**/*.cs,**/RoomPlannerDocumentBases.cs</ExcludeByFile>
          <Exclude>[FurniSpace.Testing]*</Exclude>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
